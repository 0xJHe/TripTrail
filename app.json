{
  "expo": {
    "name": "TripTrail",
    "slug": "triptrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "triptrail",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.triptrail.app",
      "adaptiveIcon": {
        "backgroundColor": "#00A38F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TripTrail uses your location during a trip to tick off stops and keep the day's plan on time."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TripTrail lets you add a photo to a pinned spot so your group can find it.",
          "cameraPermission": "TripTrail lets you take a photo of a pinned spot so your group can find it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14284F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
